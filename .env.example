# LLM backend: "anthropic" for real calls, "fake" for offline development and tests
LLM_BACKEND=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_FAST_MODEL=claude-haiku-4-5

# Google Fact Check Tools API (claims:search). Leave empty to skip stage 3.
FACTCHECK_API_KEY=

# AI-image detector: Walter Writes (https://docs.walterwrites.ai/api-reference/image-detector).
# Create a key with the image_detector scope in the developer portal.
# Leave the API key empty to use the null detector (always "no signal").
# Threshold applies to P(fake) + P(inpainting) in [0, 1].
DETECTOR_API_KEY=
DETECTOR_URL=https://developer-portal.walterwrites.ai/api/image-detector/predict/
DETECTOR_THRESHOLD=0.9

# Stage 0 perceptual hash: max Hamming distance (of 64 bits) to count as the same image
PHASH_MAX_DISTANCE=10

# Timeouts in seconds
STAGE_TIMEOUT=30
WEB_STAGE_TIMEOUT=180

# Traces and replay
TRACE_DIR=traces
REPLAY_MODE=false

# Postgres + pgvector (docker compose up -d). Leave empty to use the in-memory store.
# Must use the asyncpg driver prefix.
POSTGRES_URL=

# Optional local OCR service; run frontend/image-context on port 8001.
IMAGE_CONTEXT_URL=
# IMAGE_CONTEXT_URL=http://127.0.0.1:8001
IMAGE_CONTEXT_API_KEY=
OCR_TIMEOUT=25
IMAGE_VISION_ENABLED=true
IMAGE_CONTEXT_TIMEOUT=600
# POSTGRES_URL=postgresql+asyncpg://factcheck:factcheck@localhost:5433/factcheck
