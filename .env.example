# LLM backend: "live" for real model calls, "fake" for offline development and tests
LLM_BACKEND=fake
# Model specs are provider-prefixed: anthropic:, openai:, kimi:, gemini:, ollama:, groq:, openrouter:
# e.g. openai:gpt-5, kimi:kimi-k2, gemini:gemini-2.5-flash, ollama:gemma3:12b
LLM_MODEL=anthropic:claude-opus-5
LLM_FAST_MODEL=anthropic:claude-haiku-4-5
# Stage 4 web research is the slowest call; Sonnet 5.5 is tuned for speed. Fewer searches = faster.
# Research mode "native" uses the search model's own search tool, so the search role must be anthropic:.
LLM_SEARCH_MODEL=anthropic:claude-sonnet-5-5
RESEARCH_MODE=native
WEB_SEARCH_MAX_USES=4
LLM_REQUEST_TIMEOUT=120
# Model-name prefixes that take no image input (built in: kimi-k2, deepseek, gpt-oss)
LLM_TEXT_ONLY_MODELS=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# Google Fact Check Tools API (claims:search). Leave empty to skip stage 3.
FACTCHECK_API_KEY=

# AI-image detector: Walter Writes (https://docs.walterwrites.ai/api-reference/image-detector).
# Create a key with the image_detector scope in the developer portal.
# Leave the API key empty to use the null detector (always "no signal").
# Threshold applies to P(fake) + P(inpainting) in [0, 1].
DETECTOR_API_KEY=
DETECTOR_URL=https://developer-portal.walterwrites.ai/api/image-detector/predict/
DETECTOR_THRESHOLD=0.9

# Reverse image search for the origin card: Google Cloud Vision web detection, filtered to
# reputable domains (Wikimedia, wire services, major newsrooms, fact-checkers). Leave the key
# empty to skip. Free for 1,000 images/month; the per-process daily cap keeps the default inside that.
# Any Google API key with the Vision API enabled on its project works (it can be the fact-check key).
REVERSE_IMAGE_API_KEY=
REVERSE_IMAGE_DAILY_LIMIT=30
# REVERSE_IMAGE_TRUSTED_DOMAINS=wikimedia.org,reuters.com,apnews.com

# Stage 0 perceptual hash: max Hamming distance (of 64 bits) to count as the same image
PHASH_MAX_DISTANCE=10

# Timeouts in seconds
STAGE_TIMEOUT=30
WEB_STAGE_TIMEOUT=180

# Traces and replay
TRACE_DIR=traces
REPLAY_MODE=false

# Postgres + pgvector (docker compose up -d). Leave empty to use the in-memory store.
# Must use the asyncpg driver prefix.
POSTGRES_URL=

# Optional local OCR service; run frontend/image-context on port 8001.
IMAGE_CONTEXT_URL=
# IMAGE_CONTEXT_URL=http://127.0.0.1:8001
IMAGE_CONTEXT_API_KEY=
OCR_TIMEOUT=25
IMAGE_VISION_ENABLED=true
IMAGE_CONTEXT_TIMEOUT=600
# POSTGRES_URL=postgresql+asyncpg://factcheck:factcheck@localhost:5433/factcheck
