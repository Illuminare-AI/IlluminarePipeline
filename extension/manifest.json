{
  "manifest_version": 3,
  "name": "Luminate",
  "version": "0.1.0",
  "description": "Fact-check selected text, an image, or a region of any page with your local Luminate pipeline.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Luminate", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
