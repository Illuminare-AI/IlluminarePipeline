# Copy to .env; uvicorn --env-file requires python-dotenv, or set shell variables.
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3-vl:4b
VISION_ENABLED=true
OCR_LANGUAGE=eng
# Set when Tesseract is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Required if exposing this service beyond loopback. Bot sends X-API-Key.
CONTEXT_API_KEY=
IMAGE_ALLOWED_HOSTS=i.redd.it,preview.redd.it,external-preview.redd.it
